#tag WindowCode
	#tag Event
		Sub Activated()
		  NumberTextField.Text = "0"
		End Sub
	#tag EndEvent

	#tag Event
		Sub Opening()
		  NumberTextField.Text = "0"
		End Sub
	#tag EndEvent


	#tag Property, Flags = &h0
		SubmittedIndex As String
	#tag EndProperty


#tag EndWindowCode

#tag Events NumberTextField
	#tag Event
		Function KeyDown(key As String) As Boolean
		  Var digits As String = "0123456789"
		  Var sofar As String = me.Text
		  Var result As Integer
		  If key = Chr(13) Or key = Chr(8) Or key = Chr(28) Or key = Chr(29) Then
		    Return False
		  ElseIf digits.IndexOf(key) = -1 Then
		    System.Beep
		    Return True
		  Else
		    sofar = sofar + key
		    result = sofar.ToInteger
		    If result > 250 Then
		      System.Beep
		      Return True
		    End If
		    Return False
		  End If
		End Function
	#tag EndEvent
#tag EndEvents
#tag Events SubmitButton
	#tag Event
		Sub Pressed()
		  SubmittedIndex = NumberTextField.Text
		  Self.Hide
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events CancelButton
	#tag Event
		Sub Pressed()
		  SubmittedIndex = ""
		  Self.Hide
		End Sub
	#tag EndEvent
#tag EndEvents
