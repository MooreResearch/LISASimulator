   MinimumHeight   =   64
   MinimumWidth    =   64
   Resizeable      =   False
   Title           =   "Untitled"
   Type            =   2
   Visible         =   True
   Width           =   306
   Begin DesktopLabel TitleLabel
      AllowAutoDeactivate=   True
      Bold            =   False
      Enabled         =   True
      FontName        =   "System"
      FontSize        =   0.0
      FontUnit        =   0
      Height          =   23
      Index           =   -2147483648
      Italic          =   False
      Left            =   20
      LockBottom      =   False
      LockedInPosition=   False
      LockLeft        =   True
      LockRight       =   False
      LockTop         =   True
      Multiline       =   False
      Scope           =   0
      Selectable      =   False
      TabIndex        =   0
      TabPanelIndex   =   0
      TabStop         =   True
      Text            =   "Choose the denominator of this derivative:"
      TextAlignment   =   0
      TextColor       =   &c000000
      Tooltip         =   ""
      Top             =   20
      Transparent     =   False
      Underline       =   False
      Visible         =   True
      Width           =   266
   End
   Begin DesktopPopupMenu ParameterPopupMenu
      AllowAutoDeactivate=   True
      Bold            =   False
      Enabled         =   True
      FontName        =   "System"
      FontSize        =   0.0
      FontUnit        =   0
      Height          =   20
      Index           =   -2147483648
      InitialValue    =   "Dχ1\nDθ1\nDφ1\nDχ2\nDθ2\nDφ2\nDδ\nDlnτc\nDλ0\nDlnM\nDβ\nDψ\nDlnR\nDΘ\nDΦ\n(Cancel)"
      Italic          =   False
      Left            =   105
      LockBottom      =   False
      LockedInPosition=   False
      LockLeft        =   True
      LockRight       =   False
      LockTop         =   True
      Scope           =   0
      SelectedRowIndex=   -1
      TabIndex        =   1
      TabPanelIndex   =   0
      TabStop         =   True
      Tooltip         =   ""
      Top             =   55
      Transparent     =   False
      Underline       =   False
      Visible         =   True
      Width           =   96
   End
End
#tag EndDesktopWindow

#tag WindowCode
	#tag Event
		Sub Activated()
		  ParameterPopupMenu.SelectedRowIndex = -1
		End Sub
	#tag EndEvent


	#tag Property, Flags = &h0
		Param As String
	#tag EndProperty


#tag EndWindowCode

#tag Events ParameterPopupMenu
	#tag Event
		Sub SelectionChanged(item As DesktopMenuItem)
		  Param = me.SelectedRowText
		  self.Hide
		End Sub
	#tag EndEvent
#tag EndEvents
